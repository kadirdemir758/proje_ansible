# ═══════════════════════════════════════════════════════════════
#  Obilet Mikroservis Çevre Değişkenleri
#  ⚠️  Bu dosyayı .gitignore'a ekleyin! Commit etmeyin!
#  Kopyalayın: cp .env.microservices.example .env.microservices
# ═══════════════════════════════════════════════════════════════

# ─── Veritabanı ───────────────────────────────────────────────
DATABASE_URL = "postgresql+asyncpg://obilet:obilet123@postgres:5432/obiletdb"
DATABASE_URL_SYNC=postgresql://obilet:obilet123@postgres:5432/obiletdb

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:redis123@redis:6379/0

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── JWT (Production'da MUTLAKA değiştirin!) ──────────────────
SECRET_KEY=obilet-super-secret-jwt-key-CHANGE-IN-PRODUCTION-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["*"]

# ─── E-posta (Phase 2) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@obilet.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM_NAME=Obilet

# ─── Ödeme — Iyzico Sandbox (Phase 2) ─────────────────────────
IYZICO_API_KEY=sandbox-your-api-key
IYZICO_SECRET_KEY=sandbox-your-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─── Uygulama ─────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
